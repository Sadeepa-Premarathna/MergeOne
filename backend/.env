# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/dairyshop
MONGODB_DB=dairyshop

# Frontend URL
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=dairylicious-super-secret-jwt-key-2025
JWT_EXPIRE=7d

# Email Configuration (for OTP)
# You'll need to set these up with your Gmail account
# Enable 2FA and create an App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-app-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Configuration
MAX_FILE_SIZE=5000000
